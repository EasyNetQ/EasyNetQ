<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>EasyNetQ core: transport-agnostic messaging pipeline, registry and facades</Description>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <EasyNetQAotCompatible>true</EasyNetQAotCompatible>
    <PackageId>EasyNetQ.Core</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <!-- The source generator ships inside this package as an analyzer (with buildTransitive/EasyNetQ.Core.props for its
       InterceptorsNamespaces opt-in), so every consumer of EasyNetQ gets [MessageType] and the generated registrations.
       No ProjectReference: one with other global properties than EasyNetQ.SourceReference.props builds the generator
       twice (tests/source-reference). The solution builds it; pack only picks up its output. -->
  <ItemGroup>
    <None Include="buildTransitive/EasyNetQ.Core.props" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>
  <Target Name="_EasyNetQPackGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\EasyNetQ.Generators\EasyNetQ.Generators.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_EasyNetQGeneratorAssembly" />
    </MSBuild>
    <Error Condition="!Exists('@(_EasyNetQGeneratorAssembly)')"
           Text="EasyNetQ.Generators is not built ($(Configuration)); pack the solution, not EasyNetQ.Core alone." />
    <ItemGroup>
      <None Include="@(_EasyNetQGeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
  <ItemGroup Label="InternalsVisibleTo">
    <InternalsVisibleTo Include="EasyNetQ.RabbitMQ" />
    <InternalsVisibleTo Include="EasyNetQ" />
    <InternalsVisibleTo Include="EasyNetQ.Tests" />
    <InternalsVisibleTo Include="EasyNetQ.Core.Tests" />
    <InternalsVisibleTo Include="EasyNetQ.Hosepipe" />
    <InternalsVisibleTo Include="EasyNetQ.Hosepipe.Tests" />
    <InternalsVisibleTo Include="EasyNetQ.Serialization.Tests" />
    <InternalsVisibleTo Include="EasyNetQ.Benchmarks" />
    <InternalsVisibleTo Include="EasyNetQ.AllocationTests" />
  </ItemGroup>
</Project>
