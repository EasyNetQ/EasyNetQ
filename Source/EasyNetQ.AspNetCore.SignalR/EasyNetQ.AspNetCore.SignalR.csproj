<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>SignalR scale-out over EasyNetQ: a HubLifetimeManager backplane on any EasyNetQ transport (RabbitMQ, in-memory)</Description>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <EasyNetQAotCompatible>true</EasyNetQAotCompatible>
    <PackageId>EasyNetQ.AspNetCore.SignalR</PackageId>
    <PackageTags>$(PackageTags);SignalR;Backplane;ScaleOut</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\EasyNetQ.Core\EasyNetQ.Core.csproj" />
  </ItemGroup>
  <ItemGroup Label="InternalsVisibleTo">
    <InternalsVisibleTo Include="EasyNetQ.AspNetCore.SignalR.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- this package's own README, not the repository one Directory.Build.props packs for every project -->
    <None Remove="README.md;..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
