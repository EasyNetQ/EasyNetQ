<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <NoWarn>$(NoWarn);NU1507</NoWarn>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
        <!-- The generator runs inside the consumer's compiler: oldest supported Roslyn, from .NET SDK 10.0.100 (LTS) -->
        <EasyNetQGeneratorRoslynVersion>5.0.0</EasyNetQGeneratorRoslynVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="docker.dotnet" Version="3.125.15" />
        <PackageVersion Include="EasyNetQ.Management.Client" Version="3.0.1" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageVersion Include="NSubstitute" Version="6.2.0" />
        <PackageVersion Include="PolySharp" Version="1.17.1" />
        <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
        <PackageVersion Include="RabbitMQ.Client" Version="7.3.0" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="System.Memory" Version="4.6.3" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageVersion>
    </ItemGroup>
    <!-- net11.0 assets depend on the 11.0 packages; netstandard2.0 and net10.0 stay on 10.0, which still supports
         .NET 8/9 and .NET Framework consumers -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
        <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="11.0.0" />
        <PackageVersion Include="System.Text.Json" Version="11.0.0" />
        <PackageVersion Include="System.Threading.Channels" Version="11.0.0" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
        <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
        <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.15" />
        <PackageVersion Include="System.Text.Json" Version="10.0.15" />
        <PackageVersion Include="System.Threading.Channels" Version="10.0.15" />
    </ItemGroup>
    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <GlobalPackageReference Include="MinVer" Version="8.0.0" />
    </ItemGroup>
</Project>
